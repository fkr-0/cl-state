(test inversion-captures-custom-mutable-prior-value-by-ownership-protocol (let* ((leaf (make-algebra-mutable-leaf :payload (vector 1 2))) (state (make-state :initial (list :leaf leaf))) (prior (state-ref state :leaf)) (patch (make-patch :path :leaf :op :set :value :replacement))) (multiple-value-bind (inverse failure) (cl-state.patch::%invert-patch patch prior t) (is (null failure)) (setf (aref (algebra-mutable-leaf-payload prior) 0) 99) (apply-patch state patch) (apply-patch state inverse) (is (= 1 (aref (algebra-mutable-leaf-payload (state-ref state :leaf)) 0))))))

(test composed-patches-have-eager-shared-parity-and-retain-source-snapshots (dolist (backend ' (:hash-table :plist)) (let* ((source (make-state :initial ' (:count 1 :items (2 3) :nested (:x 4) :gone :yes) :backend backend)) (patches (list (make-patch :path :count :op :set :value 7) (make-patch :path :count :op :set :value 8) (make-patch :path :items :op :merge :value ' (0 1)) (make-patch :path :items :op :merge :value ' (2)) (make-patch :path ' (:nested :x) :op :update :value #'1+) (make-patch :path :gone :op :remove :value nil))) (source-count (state-ref source :count)) (source-items (copy-list (state-ref source :items)))) (multiple-value-bind (composed conflicts) (cl-state.patch::%compose-patches patches) (is (plusp (length conflicts))) (let ((eager (apply-patches-persistent source composed :name :algebra-eager)) (shared (cl-state.patch::apply-patches-shared source composed :name :algebra-shared))) (is-true (%same-path-values-p eager shared ' (:count :items (:nested :x) :gone))) (is (= source-count (state-ref source :count))) (is (equal source-items (state-ref source :items))) (is-true (state-frozen-p shared)))))))

