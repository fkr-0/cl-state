(defun %same-path-values-p (left right paths) (every (lambda (path) (equal (state-ref left path :missing) (state-ref right path :missing))) paths))

(test normalized-patch-boundary-is-typed-and-non-mutating (signals invalid-patch-path (make-patch :path nil :op :set :value 1)) (signals invalid-patch-path (make-patch :path ' (:a nil) :op :set :value 1)) (signals invalid-patch-operation (make-patch :path :a :op :bogus :value 1)) (signals invalid-patch-value (make-patch :path :a :op :merge :value (cons 1 2))) (signals invalid-patch-value (make-patch :path :a :op :update :value 42)) (signals invalid-patch-format (normalize-patches ' ((:a 1 2)))) (let* ((raw (cl-state.patch::%make-patch :path ' (:a nil) :op :bogus :value 1)) (state (make-state :initial ' (:a 7))) (revision (state-revision state))) (signals invalid-patch-path (normalize-patches (list raw))) (signals invalid-patch-path (apply-patch state raw)) (is (= 7 (state-ref state :a))) (is (= revision (state-revision state)))))

(test deletion-shorthands-and-diff-round-trip-on-both-backends (dolist (backend ' (:hash-table :plist)) (let* ((old-state (make-state :initial ' (:a 1 :nested (:x 2 :gone 3)) :backend backend)) (new-state (make-state :initial ' (:a 9 :nested (:x 2 :new 4)) :backend backend)) (old (state-snapshot old-state)) (new (state-snapshot new-state)) (diff (diff-states old new)) (applied (apply-patches (deep-copy-data old) diff))) (is (= 9 (get-path :a applied))) (is (= 2 (get-path ' (:nested :x) applied))) (is (= 4 (get-path ' (:nested :new) applied))) (is (eq :missing (get-path ' (:nested :gone) applied :missing))) (is (some (lambda (patch) (eq (second patch) :elmtui-delete-path)) diff)) (let ((normalized (first (normalize-patches ' ((:legacy :removed)))))) (is (eq :remove (patch-op normalized)))))))

(test history-sentinels-do-not-collide-with-legitimate-keyword-values (dolist (backend ' (:hash-table :plist)) (let ((state (make-state :initial ' (:old :not-present) :backend backend))) (with-transaction (state :name :literal-sentinels) (state-set state :old :changed) (state-set state :new :elmtui-delete-path)) (undo state) (is (eq :not-present (state-ref state :old))) (is (eq :missing (state-ref state :new :missing))) (redo state) (is (eq :changed (state-ref state :old))) (is (eq :elmtui-delete-path (state-ref state :new))))))

(test pair-composition-is-conservative-and-does-not-run-opaque-updates (let* ((left (make-patch :path :a :op :set :value 1)) (right (make-patch :path :a :op :set :value 2))) (multiple-value-bind (composed conflicts) (cl-state.patch::%compose-patches (list left right)) (is (= 1 (length composed))) (is (= 2 (patch-value (first composed)))) (is (null conflicts)) (is (= 1 (patch-value left))))) (multiple-value-bind (composed conflicts) (cl-state.patch::%compose-patches (list (make-patch :path :a :op :set :value 1) (make-patch :path :b :op :set :value 2))) (is (= 2 (length composed))) (is (null conflicts))) (multiple-value-bind (composed conflicts) (cl-state.patch::%compose-patches (list (make-patch :path :tree :op :set :value ' (:leaf 1)) (make-patch :path ' (:tree :leaf) :op :set :value 2))) (is (= 2 (length composed))) (is (= 1 (length conflicts))) (is (eq :overlapping-paths (cl-state.patch::patch-algebra-conflict-reason (first conflicts))))) (let ((calls 0)) (multiple-value-bind (composed conflicts) (cl-state.patch::%compose-patches (list (make-patch :path :a :op :set :value 1) (make-patch :path :a :op :update :value (lambda (value) (incf calls) (1+ value))))) (is (= 2 (length composed))) (is (= 1 (length conflicts))) (is (eq :opaque-update (cl-state.patch::patch-algebra-conflict-reason (first conflicts)))) (is (= 0 calls)))))

(test deterministic-composition-state-machine-preserves-sequential-application (dolist (backend ' (:hash-table :plist)) (let ((sequential (make-state :initial ' (:a 0 :b 0 :nested (:x 1) :items (5 6)) :backend backend)) (composed-state (make-state :initial ' (:a 0 :b 0 :nested (:x 1) :items (5 6)) :backend backend))) (dotimes (step 96) (let ((patches (case (mod step 6) (0 (list (make-patch :path :a :op :set :value step) (make-patch :path :a :op :set :value (1+ step)))) (1 (list (make-patch :path :a :op :set :value step) (make-patch :path :b :op :set :value (* 2 step)))) (2 (list (make-patch :path :nested :op :set :value (list :x step :y step)) (make-patch :path ' (:nested :x) :op :set :value (1+ step)))) (3 (list (make-patch :path :flag :op :remove :value nil) (make-patch :path :flag :op :set :value step))) (4 (list (make-patch :path :items :op :merge :value (list step)) (make-patch :path :a :op :set :value (- step)))) (otherwise (list (make-patch :path :items :op :merge :value (list step)) (make-patch :path :items :op :merge :value (list (1+ step)))))))) (multiple-value-bind (composed conflicts) (cl-state.patch::%compose-patches patches) (declare (ignore conflicts)) (apply-patches sequential patches) (apply-patches composed-state composed) (is-true (%same-path-values-p sequential composed-state ' (:a :b :flag :items (:nested :x) (:nested :y))))))))))

(test inversion-requires-prior-state-and-rejects-raw-update-functions (dolist (backend ' (:hash-table :plist)) (dolist (patch (list (make-patch :path :a :op :set :value 9) (make-patch :path :a :op :remove :value nil) (make-patch :path :items :op :merge :value ' (0)))) (let* ((state (make-state :initial ' (:a 1 :items (2 3)) :backend backend)) (path (patch-path patch)) (marker (gensym "MISSING-")) (prior (state-value state path marker)) (present-p (not (eq prior marker)))) (multiple-value-bind (inverse failure) (cl-state.patch::%invert-patch patch prior present-p) (is (null failure)) (apply-patch state patch) (apply-patch state inverse) (is (equal prior (state-ref state path marker))))))) (let* ((calls 0) (update (make-patch :path :a :op :update :value (lambda (value) (incf calls) (1+ value))))) (multiple-value-bind (inverse failure) (cl-state.patch::%invert-patch update 1 t) (is (null inverse)) (is (typep failure 'cl-state.patch::patch-inversion-failure)) (is (eq :opaque-update (cl-state.patch::patch-inversion-failure-reason failure))) (is (= 0 calls)))) (let ((state (make-state :initial ' (:count 1)))) (apply-patches state (list (make-patch :path :count :op :update :value #'1+))) (let* ((change (first (tx-changes (first (application-state-history state))))) (inverse (cl-state.patch::%invert-change-record change))) (apply-patch state inverse) (is (= 1 (state-ref state :count))))))

(defstruct algebra-mutable-leaf payload)

