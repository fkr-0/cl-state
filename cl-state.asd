;;; cl-state.asd
(asdf:defsystem "cl-state" :description "State container, patches, transactions, undo/redo, observers, schema, validation." :license "MIT" :version "0.2.0" :author "ElmTUI contributors" :maintainer "ElmTUI contributors" :depends-on (#:alexandria #:uiop #:bordeaux-threads) :components ((:file "src/state/packages") (:file "src/state/utils") (:file "src/state/value-protocol") (:file "src/state/core") (:file "src/state/tx") (:file "src/state/patch") (:file "src/state/algebra") (:file "src/state/persistent") (:file "src/state/undo") (:file "src/state/observer") (:file "src/state/schema") (:file "src/state/validation") (:file "src/state/api")) :in-order-to ((test-op (test-op "cl-state-tests"))))
